# Proof Gatekeeper agent — copy to .env and fill in. NEVER commit .env.
# Secrets are shown ONCE on the Agent Games dashboard / Kurier signup —
# copy them here (or set them as environment variables on your host).

# HMAC secret from the Agent Games dashboard (Agent -> Rotate Secret).
# A placeholder fails preflight with a signature error.
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key from https://kurier.xyz (sign up, copy the key).
KURIER_API_KEY=

# Set to 1 to skip real Kurier calls (local testing only).
KURIER_MOCK=0

# Test mode: allows dummy secrets, defaults Kurier to mock.
# NEVER set in production.
AGENT_GAMES_TEST_MODE=0

# UNVERIFIED switches (see README "Calibration"): change only after
# practice-mode feedback.
# HMAC_ENCODING=hex          # hex | base64
# RESPONSE_SHAPE=full        # full | minimal
# TASKID_ENCODING=keccak256  # keccak256 | sha256 | raw

# Server
PORT=3000
HOST=0.0.0.0
